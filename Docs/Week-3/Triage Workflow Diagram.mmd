flowchart TB
 subgraph PHASE1["Phase 1 — Arrival & Registration"]
    direction TB
        REG["Registration\n2–3 min\nDemographics, consent &amp; arrival mode recorded"]
        AI1["AI #1: EHR auto-fill\nMatch prior visit records"]
        TRIAGE["Triage assessment\n3–5 min\nVitals, chief complaint, history &amp; ESI level recorded"]
        AI2["AI #2: ESI acuity suggestion\nVitals + complaint → proposed ESI\nNurse confirms or overrides"]
  end
 subgraph PHASE2["Phase 2 — Zone Placement"]
    direction TB
        PHASE2A["ESI 1-3 Patients\n Sent to Resus / Acute cubicles zone\nESI 1: immediate, ESI 2: ≤10 min, ESI 3: ≤30 min"]
        PHASE2B["ESI 4-5 patients: \n Sent to Fast-track zone\nTarget ≤60 min"]
  end
 subgraph PHASE3["Phase 3 — Assessment"]
    direction TB
        RETRIAGE["Re-triage / waiting room re-check\nNurse scans for deterioration"]
        AI3["AI #3: Deterioration alert\nFlag if vitals drift from baseline"]
        HP["Physician history &amp; exam\n15–30 min\nWorking diagnosis, orders placed"]
        INVEST["Investigations\n30 min – 3 hr\nLabs · imaging · ECG\nShared lab — common bottleneck"]
        AI4["AI #4: Order support &amp; critical alerts\nOrder set suggestions, flag critical results"]
        CONSULT{"Specialty\nconsult?"}
        SPEC["Specialist review\n30–60 min\n"]
        DISP{"Disposition"}
  end
 subgraph PHASE4["Phase 4 — Exit"]
    direction TB
        PHASE4A["Ward admission\nBoarding wait common\nED LOS: 6–24 hr"]
        PHASE4B["Discharge counselling\n5–10 min\nFollow-up arranged"]
        AI5["AI #5: Discharge summary draft\nAuto-generate summary + instructions\nPhysician reviews and signs"]
        PHASE4C["Transfer out\nHigher-level facility\nSBAR handover"]
  end
    ARRIVE(["Patient arrives"]) --> REG
    REG -.-> AI1
    REG --> TRIAGE
    TRIAGE -.-> AI2
    TRIAGE --> ESI_DECISION{"ESI level?"}
    ESI_DECISION --> PHASE2A
    PHASE2A --> RETRIAGE
    RETRIAGE -.-> AI3
    RETRIAGE --> HP
    HP --> INVEST
    INVEST -.-> AI4
    INVEST --> CONSULT
    CONSULT -- Yes --> SPEC
    CONSULT -- No --> DISP
    SPEC --> DISP
    DISP --> PHASE4B
    PHASE4B -.-> AI5
    PHASE4C --> EXIT(["Patient exits\nDischarge LOS: 2–4 hr · Admit LOS: 6–24 hr"])

     AI1:::ai
     AI2:::ai
     AI3:::ai
     AI4:::ai
